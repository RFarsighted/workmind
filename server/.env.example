# Copy this file to .env and add your own DeepSeek API key.
APP_ENV=development
PORT=3000

# Local development uses the host-mapped PostgreSQL and Chroma ports.
DATABASE_URL=postgresql+asyncpg://workmind:workmind_dev@localhost:5433/workmind
CHROMA_URL=http://localhost:8000

# Chat generation and RAG answers require a valid DeepSeek key.
# Health checks and document ingestion can start without this key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Knowledge ingestion and search use SiliconFlow embeddings.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
RAG_MIN_SIMILARITY=0.3

ALLOWED_ORIGINS=http://localhost:5173
