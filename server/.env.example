# Copy this file to .env and add your own DeepSeek API key.
APP_ENV=development
PORT=3000

# Local development uses the host-mapped PostgreSQL and Chroma ports.
DATABASE_URL=postgresql+asyncpg://workmind:workmind_dev@localhost:5433/workmind
CHROMA_URL=http://localhost:8000

# Chat generation requires a valid key. The API and health checks can start without it.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

ALLOWED_ORIGINS=http://localhost:5173
